# ========================
# 🗄️ Настройки базы данных
# ========================
POSTGRES_HOST=localhost        # Хост PostgreSQL
POSTGRES_PORT=5432             # Порт подключения
POSTGRES_DB=documents          # Имя базы данных
POSTGRES_USER=postgres         # Пользователь БД
POSTGRES_PASSWORD=password     # Пароль пользователя БД

# ========================
# 📂 Настройки источников данных
# ========================
DATA_SOURCES=./sources.yaml    # Файл со списком источников документов для RAG
UPLOAD_PATH=./data_storage     # Путь для загрузки и хранения файлов

# ========================
# 🤖 Настройки эмбеддинга
# ========================
HF_EMBEDDER_MODEL=             # Название модели эмбеддинга (например, sentence-transformers/all-MiniLM-L6-v2)
HF_DEVICE=cpu                  # Устройство: cpu или cuda
CHUNK_UNIT=sentences           # Единица разбиения текста (sentences, tokens и т.д.)
CHUNK_SIZE=400                 # Размер блока текста для эмбеддинга
CHUNK_OVERLAP=0                # Перекрытие между блоками
PGVECTOR_DIM=768               # Размерность векторного пространства

# ========================
# 🧠 Настройки LLM агента
# ========================
LLM_TYPE=openai                # Тип модели: openai, ollama, groq
LLM_BASE_URL=                  # Базовый URL API (если используется локальный сервер)
LLM_MODEL_NAME=                # Имя модели (например, gpt-4o-mini)
LLM_API_KEY=                   # API-ключ для LLM-провайдера
LLM_TEMPERATURE=0.0            # Степень креативности (0 — максимально детерминированно)
PROMPTS_PATH=./src/application/prompts  # Путь к шаблонам промптов

# ========================
# 🚀 FastAPI настройки
# ========================
FASTAPI_HOST=127.0.0.1         # Адрес хоста FastAPI
FASTAPI_PORT=8000              # Порт приложения
APP_NAME=DevSecOps Assistant   # Название приложения
VERSION=0.1                    # Версия проекта
DEBUG=False                    # Режим отладки (True/False)
